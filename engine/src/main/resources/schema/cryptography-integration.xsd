<?xml version="1.0" encoding="UTF-8" ?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          targetNamespace="http://www.testlum.com/testing/model/global-config"
          xmlns:tns="http://www.testlum.com/testing/model/global-config"
          elementFormDefault="qualified"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0">

    <x:include schemaLocation="shared-config.xsd"/>
    
    <x:complexType name="cryptographyIntegrations">
        <x:choice>
            <x:element name="cryptography" type="tns:cryptography" maxOccurs="unbounded"/>
        </x:choice>
    </x:complexType>
    
    <x:complexType name="cryptography">
        <x:complexContent>
            <x:extension base="tns:integration">
                <x:sequence>
                    <x:element name="secret" type="tns:nonEmptyString" minOccurs="1" maxOccurs="1"/>
                </x:sequence>

                <x:attribute name="method" type="tns:cryptoMethods" use="required"/>
            </x:extension>
        </x:complexContent>
    </x:complexType>
    
    <x:simpleType name="cryptoMethods">
        <x:restriction base="x:string">
            <x:enumeration value="AES"/>
            <x:enumeration value="ECC"/>
            <x:enumeration value="CHACHA20"/>
        </x:restriction>
    </x:simpleType>

</x:schema>