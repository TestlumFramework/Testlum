<?xml version="1.0" encoding="UTF-8"?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          targetNamespace="http://www.testlum.com/testing/model/scenario"
          xmlns:tns="http://www.testlum.com/testing/model/scenario"
          elementFormDefault="qualified"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0">

    <x:include schemaLocation="shared.xsd"/>

    <x:complexType name="email">
        <x:complexContent>
            <x:extension base="tns:abstractUiCommand">
                <x:attribute name="alias" type="tns:aliasPattern" default="DEFAULT"/>
                <x:attribute name="pattern" type="tns:nonEmptyString" use="required"/>
                <x:attribute name="timeout" type="x:positiveInteger" default="10000"/>
                <x:attribute name="targetVariable" type="tns:nonEmptyString"/>
            </x:extension>
        </x:complexContent>
    </x:complexType>

    <x:complexType name="inputEmail">
        <x:complexContent>
            <x:extension base="tns:commandWithLocator">
                <x:attribute name="alias" type="tns:aliasPattern" default="DEFAULT"/>
                <x:attribute name="pattern" type="tns:nonEmptyString" use="required"/>
                <x:attribute name="timeout" type="x:positiveInteger" default="10000"/>
                <x:attribute name="highlight" type="x:boolean" default="true"/>
                <x:attribute name="targetVariable" type="tns:nonEmptyString"/>
            </x:extension>
        </x:complexContent>
    </x:complexType>

</x:schema>
