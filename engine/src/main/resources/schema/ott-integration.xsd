<?xml version="1.0" encoding="UTF-8"?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          targetNamespace="http://www.testlum.com/testing/model/global-config"
          xmlns:tns="http://www.testlum.com/testing/model/global-config"
          elementFormDefault="qualified"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0">

    <x:include schemaLocation="shared-config.xsd"/>

    <x:complexType name="ottIntegration">
        <x:choice maxOccurs="unbounded">
            <x:element name="ott" type="tns:ott"/>
        </x:choice>
    </x:complexType>


    <x:complexType name="ott">
        <x:complexContent>
            <x:extension base="tns:integration">
                <x:sequence>
                    <x:element name="secretKey" type="tns:base32Secret"/>
                </x:sequence>
            </x:extension>
        </x:complexContent>
    </x:complexType>
</x:schema>

