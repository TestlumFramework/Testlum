<?xml version="1.0" encoding="UTF-8"?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          targetNamespace="http://www.testlum.com/testing/model/global-config"
          xmlns:tns="http://www.testlum.com/testing/model/global-config"
          elementFormDefault="qualified"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0">

    <x:include schemaLocation="extent-reports-config.xsd"/>

    <x:complexType name="report">
        <x:sequence>
            <x:element name="extentReports" type="tns:extentReports"/>
            <x:element name="junit" type="tns:junitReport" minOccurs="0"/>
        </x:sequence>
    </x:complexType>

    <x:complexType name="junitReport">
        <x:attribute name="enabled" type="x:boolean" use="required"/>
    </x:complexType>

</x:schema>
