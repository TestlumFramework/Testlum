<?xml version="1.0" encoding="UTF-8"?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          elementFormDefault="qualified"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0">

    <x:simpleType name="aliasPattern">
        <x:restriction base="x:string">
            <x:pattern value="[a-zA-Z_\-/\d]+"/>
<!--            <x:pattern value="\{\{.+\}\}"/>-->
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="nonEmptyString">
        <x:restriction base="x:string">
            <x:minLength value="1"/>
            <x:pattern value="(\s*[\S*]\s*)*"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="stringMin10">
        <x:restriction base="x:string">
            <x:minLength value="10"/>
            <x:pattern value="(\s*[\S*]\s*)*"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="stringMin30">
        <x:restriction base="x:string">
            <x:minLength value="30"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="positiveIntegerMin1">
        <x:restriction base="x:int">
            <x:minInclusive value="1"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="jsFileExtension">
        <x:restriction base="x:string">
            <x:pattern value=".+(\.js)"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="jsonFileExtension">
        <x:restriction base="x:string">
            <x:pattern value=".+(\.json)"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="imageExtension">
        <x:restriction base="x:string">
            <x:pattern value=".+(\.(jpg|jpeg|png|JPG|JPEG|PNG|))"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="hostNameOrIPv4">
        <x:restriction base="x:string">
            <x:pattern
                    value="(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])(\.([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\-]{0,61}[a-zA-Z0-9]))*)|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"/>
            <x:pattern value="\{\{.*\}\}|\$\{.*\}"/>
        </x:restriction>
    </x:simpleType>

    <x:simpleType name="port">
        <x:restriction base="x:string">
            <x:pattern value="([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"/>
            <x:pattern value="\{\{.*\}\}|\$\{.*\}"/>
        </x:restriction>
    </x:simpleType>

</x:schema>
