<?xml version="1.0" encoding="UTF-8"?>
<x:schema xmlns:x="http://www.w3.org/2001/XMLSchema"
          xmlns:tns="http://www.knubisoft.com/testlum/testing/model/scenario"
          xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
          targetNamespace="http://www.knubisoft.com/testlum/testing/model/scenario"
          elementFormDefault="qualified" jaxb:version="3.0">

    <x:include schemaLocation="shared.xsd"/>

    <x:complexType name="webhook">
        <x:complexContent>
            <x:extension base="tns:abstractCommand">
                <x:sequence>
                    <x:element name="status" type="tns:codePattern" minOccurs="0"/>
                    <x:element name="expected" type="tns:expectedPattern" minOccurs="0"/>
                    <x:element name="headers" type="tns:webhookHeaders" minOccurs="0"/>
                </x:sequence>
                <x:attribute name="alias" type="tns:aliasPattern" use="required"/>
                <x:attribute name="timeout" type="tns:positiveIntegerMin1" use="required"/>
                <x:attribute name="matchValue" type="tns:nonEmptyString"/>
            </x:extension>
        </x:complexContent>
    </x:complexType>

    <x:complexType name="webhookHeaders">
        <x:complexContent>
            <x:restriction base="x:anyType">
                <x:sequence maxOccurs="unbounded">
                    <x:element name="header" type="tns:webhookHeader"/>
                </x:sequence>
            </x:restriction>
        </x:complexContent>
    </x:complexType>

    <x:complexType name="webhookHeader">
        <x:complexContent>
            <x:restriction base="x:anyType">
                <x:attribute name="name" use="required" type="tns:nonEmptyString"/>
                <x:attribute name="value" use="required" type="x:string"/>
            </x:restriction>
        </x:complexContent>
    </x:complexType>

</x:schema>
